{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "customer": {
      "root": "frontend/customer",
      "framework": "vite"
    },
    "admin": {
      "root": "frontend/admin",
      "framework": "vite"
    },
    "backend-customer": {
      "root": "backend/customer",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "backend-admin": {
      "root": "backend/admin",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/(.*)",
      "destination": { "service": "backend-admin" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend-customer" }
    },
    {
      "source": "/assets/(.*)",
      "destination": { "service": "customer", "path": "/assets/$1" }
    },
    {
      "source": "/(.*\\.(?:js|css|svg|ico|png|jpg|jpeg|webp|woff|woff2|ttf|json))",
      "destination": { "service": "customer", "path": "/$1" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "customer", "path": "/index.html" }
    }
  ]
}
